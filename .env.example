# Reference only: Spring Boot does NOT automatically load this file.
# Set these as environment variables in the backend terminal.
APP_DB_URL=jdbc:mysql://127.0.0.1:3306/ry_platform_new?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8
APP_DB_USER=your_database_user
APP_DB_PASSWORD=replace_with_your_database_password
APP_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
APP_REDIS_HOST=127.0.0.1
APP_REDIS_DB=2
APP_REDIS_PASSWORD=
APP_UPLOAD_PATH=./uploads
# For database initialization/testing only. Never use the MySQL admin as runtime user.
MYSQL_PWD=replace_with_database_administrator_password
